<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 카메라가 없는 기기에도 설치는 되도록 required=false (미션 없이 일반 알람으로 사용 가능) -->
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 정확한 시각 알람: Android 12(L)까지는 SCHEDULE_EXACT_ALARM, 13 이상은 알람 앱 전용 USE_EXACT_ALARM -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 공휴일 목록 업데이트 (구글 공개 공휴일 달력) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 폰 기본 달력의 공휴일 달력 읽기 (사용자가 허용할 때만) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- 광고(AdMob): 광고 ID. 사용자는 휴대폰 설정에서 광고 ID 를 재설정·삭제할 수 있음 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <!-- 선택: 휴대폰 사용 중에도 운동 미션 알람 화면을 전체 화면으로 띄움 (사용자가 설정에서 직접 허용) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 눈바디 잠금: 지문·얼굴·휴대폰 비밀번호로 본인 확인 (지문 정보는 안드로이드가 처리하고 앱은 성공/실패만 받음) -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- 눈바디 사진을 갤러리에 내보낼 때 Android 9 이하에서만 필요 (10 이상은 권한 없이 저장) -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 눈바디 '폰 기본 카메라로 찍기': 기본 카메라 앱을 찾기 위해 (Android 11 이상의 앱 목록 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FitAlarm"
        tools:targetApi="33">

        <!-- AdMob 앱 ID (공개 값). 광고 동의(UMP) SDK 가 여기서 읽고, 광고 SDK 는 코드(AdMobIds)에서 받음 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-9101880128165365~5622811936" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 첫 실행: 운동 안전 안내와 이용약관 동의 -->
        <activity
            android:name=".ui.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name=".ui.AlarmEditActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 알람이 울릴 때 잠금 화면 위에 뜨는 화면. 별도 태스크로 분리해 최근 앱 목록에 남지 않게 함 -->
        <!-- 세로 고정은 일반 폰에서만 코드로 (lockPortraitOnPhones). 태블릿·폴드에서는 회전·크기 조절 허용 -->
        <activity
            android:name=".ui.AlarmRingActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.ring"
            android:theme="@style/Theme.FitAlarm.Ring" />

        <activity
            android:name=".ui.DaysOffActivity"
            android:exported="false" />

        <!-- 카메라 모션 인식 미션 화면 (연습·보너스 운동 겸용) -->
        <activity
            android:name=".ui.MissionActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.FitAlarm.Ring" />

        <!-- 눈바디 (운동 미션 안의 선택 기능). 화면이 돌아도 다시 만들지 않음 (입력 중인 값·카메라 유지) -->
        <activity
            android:name=".ui.NunbodyActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ui.NunbodyCameraActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.FitAlarm.Camera" />
        <activity
            android:name=".ui.NunbodySaveActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.NunbodyPhotoActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ui.NunbodyExportActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".ui.NunbodySettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <!-- 눈바디 사진 보내기·기본 카메라 앱과 파일 주고받기 (공개하지 않고 넘겨준 파일에만 그때그때 권한) -->
        <provider
            android:name=".nunbody.NunbodyFileProvider"
            android:authorities="${applicationId}.nunbody"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- 곧 울릴 알람 알림: 예약·'알람 취소'·밀어서 지움 -->
        <receiver
            android:name=".alarm.UpcomingReceiver"
            android:exported="false" />

        <!-- 눈바디 촬영 알림 (기본 꺼짐) -->
        <receiver
            android:name=".nunbody.NunbodyReminderReceiver"
            android:exported="false" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false" />

        <!-- 공휴일 목록 하루 한 번 동기화 -->
        <service
            android:name=".holiday.HolidaySyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 홈 화면 위젯 -->
        <receiver
            android:name=".widget.AlarmWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget_info" />
        </receiver>

        <!-- 재부팅, 시간/시간대 변경, 앱 업데이트 시 알람 재등록 (모두 시스템만 보낼 수 있는 보호된 브로드캐스트) -->
        <receiver
            android:name=".alarm.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
